# ==========================================
# Mediclaim Environment Configuration
# ==========================================

# PostgreSQL Configuration
POSTGRES_DB=mediclaim
POSTGRES_USER=mediclaim
POSTGRES_PASSWORD=mediclaim_secret_password
POSTGRES_PORT=5432

# Backend Authentication & API Configuration
JWT_SECRET=mediclaim_dev_jwt_secret_change_in_production
OTP_DEBUG=true
BACKEND_PORT=8000

# Administrator Credentials
ADMIN_EMAIL=admin@mediclaim.gov.in
ADMIN_PASSWORD=Admin@123

# Frontend Configuration
FRONTEND_PORT=3000

# Mandatory Gemini Medical Document Parsing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

